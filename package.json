{
  "name": "smart-candidate-screening-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web && node scripts/postbuild.js",
    "start": "npm run start -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "test": "npm run test -w apps/api",
    "studio": "npm run studio -w apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}

