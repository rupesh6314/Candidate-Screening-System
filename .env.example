# ==============================================================================
# Smart Candidate Screening & Campus Recruitment Platform - Environment Template
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# Database (PostgreSQL Connection String - Private Network / Neon / Supabase / Railway)
DATABASE_URL="postgresql://username:password@localhost:5432/screening_db?schema=public"

# Security & JSON Web Tokens
JWT_SECRET="generate-a-secure-random-64-character-jwt-secret-key-here"

# Placement Admin Default Account Setup
ADMIN_EMAIL="admin@placement.edu"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword2026!"

# SMTP Email Dispatch Credentials (Optional for automated email alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="placement.officer@institution.edu"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM_NAME="Campus Placement Cell"
SMTP_FROM_EMAIL="placement.officer@institution.edu"

# Frontend Application URL (For CORS & Auth redirects)
VITE_API_URL=""
FRONTEND_URL="https://candidate-screening-system.vercel.app"
